# ============================================================
# FILE: .env.example (THƯ MỤC GỐC DỰ ÁN)
# PHỤ TRÁCH: Hoàng Tùng (Người 4)
#
# MỤC ĐÍCH:
# Hướng dẫn cấu hình môi trường cho LLM Server.
# File .env ĐÃ BỐ TRÍ ở thư mục gốc dự án (bên ngoài folder LLM);
# LLM Server luôn đọc .env theo đường dẫn thư mục gốc, không phụ
# thuộc vị trí khởi động.
#
# KHÔNG đặt API key thật trong file này.
# Sao chép thành .env (cùng thư mục gốc) rồi điền giá trị thực:
#     cp .env.example .env
# File .env đã có trong .gitignore thư mục gốc.
# ============================================================

# ------------------------------------------------------------
# 1. SERVER
# ------------------------------------------------------------
# Địa chỉ và cổng lắng nghe của LLM Server.
HOST=0.0.0.0
PORT=8001

# development | production
ENVIRONMENT=development

# true = không gọi model thật, trả nội dung mẫu (dùng khi BE dev chưa có key).
MOCK_MODE=false

# ------------------------------------------------------------
# 2. NHÀ CUNG CẤP MODEL
# ------------------------------------------------------------
# openrouter | openai_compat | mock
PROVIDER=openrouter

# --- OpenRouter (dùng cho LearnMate AI) ---
# Lấy API key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Khai báo nguồn cho OpenRouter (tùy chọn, nên có):
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=LearnMate AI

# --- OpenAI-compatible (tùy chọn: Ollama / vLLM / LM Studio...) ---
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=ollama

# ------------------------------------------------------------
# 3. MODEL CONFIGURATION (BẮT BUỘC - KHÔNG CÓ MẶC ĐỊNH TRONG CODE)
# BE gửi nhãn logic ("generation" / "evaluation" / "vision"),
# LLM Server ánh xạ sang ID model thật bên dưới.
# Thiếu biến nào, server báo lỗi ngay khi khởi động và nêu tên
# biến còn thiếu. Giá trị dưới đây là ví dụ, KHÔNG hardcode trong code.
# Danh sách model khả dụng: xem LLM/docs/MODEL_LIST.md
# ------------------------------------------------------------
MODEL_GENERATION=openai/gpt-4o-mini
MODEL_EVALUATION=openai/gpt-4o-mini
MODEL_VISION=openai/gpt-4o-mini
MODEL_DEFAULT=openai/gpt-4o-mini

# false = chỉ chấp nhận nhãn logic (khuyến nghị để cả nhóm dùng cùng model).
# true  = BE có thể gửi thẳng ID model của nhà cung cấp.
ALLOW_DIRECT_MODEL=false

# ------------------------------------------------------------
# 4. GIỚI HẠN GỌI MODEL
# ------------------------------------------------------------
# Thời gian chờ tối đa cho một lần gọi model (giây).
REQUEST_TIMEOUT_SECONDS=60

# Số lần thử lại tối đa khi bị timeout / 429 / 5xx (ngoài lần đầu).
MAX_RETRIES=2

# Khoảng nghỉ cơ bản giữa các lần retry (giây), nhân lũy thừa 2: 1s, 2s, 4s...
RETRY_BACKOFF_SECONDS=1.0

# Giới hạn số request mỗi phút cho toàn server.
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# Giới hạn kích thước prompt (ký tự).
MAX_PROMPT_CHARS=20000

# Giới hạn trên của max_output_tokens do BE gửi lên.
MAX_OUTPUT_TOKENS_LIMIT=4000

# Giá trị mặc định nếu BE không gửi temperature / max_output_tokens.
DEFAULT_TEMPERATURE=0.5
DEFAULT_MAX_OUTPUT_TOKENS=1800

# ------------------------------------------------------------
# 5. BẢO MẬT NỘI BỘ (TÙY CHỌN)
# Nếu đặt giá trị, BE phải gửi header: X-Internal-Api-Key: <giá trị>
# Để trống = tắt kiểm tra (môi trường demo nội bộ, tin cậy).
# ------------------------------------------------------------
INTERNAL_API_KEY=

# ------------------------------------------------------------
# 6. HƯỚNG DẪN
# - Sao chép .env.example thành .env rồi điền giá trị.
# - KHÔNG commit .env lên Git.
# - KHÔNG nhúng OPENROUTER_API_KEY vào Frontend.
# - Bí mật không in ra log (LLM Server đã lọc sẵn).
# ------------------------------------------------------------
