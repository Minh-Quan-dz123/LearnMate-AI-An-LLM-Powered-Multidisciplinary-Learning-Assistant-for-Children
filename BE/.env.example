# ============================================================
# FILE: .env.example
#
# MỤC ĐÍCH:
# Hướng dẫn cấu hình môi trường cho Backend.
#
# Không đặt API Key thật trong file này.
# ============================================================


# 1. SUPABASE
#
# SUPABASE_URL=
# URL project Supabase.
#
# SUPABASE_KEY=
# API Key để Backend thao tác Database.
# Chọn loại key phù hợp với cách truy cập đã thiết kế.
# Nếu sử dụng key có quyền cao, tuyệt đối chỉ giữ ở Backend.


# 2. LLM SERVER
#
# LLM_SERVER_URL=
# Địa chỉ HTTP của LLM Server.
#
# LLM_TIMEOUT_SECONDS=
# Thời gian chờ tối đa cho một request.


# 3. MODEL CONFIGURATION (TÙY CHỌN)
#
# LLM_GENERATION_MODEL=
# Tên hoặc nhãn logic cho model sinh câu hỏi.
#
# LLM_EVALUATION_MODEL=
# Tên hoặc nhãn logic cho model đánh giá câu trả lời.
#
# LLM_INTERNAL_API_KEY=
# Tùy chọn nếu hai server dùng shared secret.


# 4. HƯỚNG DẪN
#
# - Sao chép .env.example thành .env.
# - Bỏ dấu # ở các biến cấu hình cần sử dụng.
# - Điền giá trị thực vào file .env.
# - Không commit .env.
# - Đảm bảo tên biến khớp với app/config.py.