# ===== GEMINI =====

# API Key lấy từ Google AI Studio
GEMINI_API_KEY=your_api_key_here

# Tên model Gemini, điền sau khi chọn model
GEMINI_MODEL=your_model_id_here


# ===== LLM SERVER =====

# Nhà cung cấp AI đang sử dụng
LLM_PROVIDER=gemini

# Địa chỉ và cổng chạy LLM_V1
LLM_HOST=127.0.0.1
LLM_PORT=8001